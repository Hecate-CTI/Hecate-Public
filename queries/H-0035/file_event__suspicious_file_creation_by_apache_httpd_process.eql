any where (process.executable like~ ("*/httpd", "*/apache2")) and (file.path like~ ("*/var/www/*", "*/usr/share/nginx/html/*", "*/srv/http/*", "*/tmp/*", "*/dev/shm/*")) and (file.path like~ ("*.php", "*.phtml", "*.php5", "*.sh", "*.py", "*.pl", "*.so", "*.elf")) and (not (file.path like~ ("*.log", "*.pid", "*.lock", "*.tmp")))

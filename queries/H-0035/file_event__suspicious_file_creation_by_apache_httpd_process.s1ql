ObjectType = "File" AND (EndpointOS = "linux" AND ((SrcProcImagePath endswithCIS "/httpd" OR SrcProcImagePath endswithCIS "/apache2") AND (TgtFilePath containsCIS "/var/www/" OR TgtFilePath containsCIS "/usr/share/nginx/html/" OR TgtFilePath containsCIS "/srv/http/" OR TgtFilePath containsCIS "/tmp/" OR TgtFilePath containsCIS "/dev/shm/") AND (TgtFilePath endswithCIS ".php" OR TgtFilePath endswithCIS ".phtml" OR TgtFilePath endswithCIS ".php5" OR TgtFilePath endswithCIS ".sh" OR TgtFilePath endswithCIS ".py" OR TgtFilePath endswithCIS ".pl" OR TgtFilePath endswithCIS ".so" OR TgtFilePath endswithCIS ".elf") AND (NOT (TgtFilePath endswithCIS ".log" OR TgtFilePath endswithCIS ".pid" OR TgtFilePath endswithCIS ".lock" OR TgtFilePath endswithCIS ".tmp"))))

where((process.exe_path=/^.*\/httpd$/i OR process.exe_path=/^.*\/apache2$/i) AND (file.path=/^.*\/var\/www\/.*$/i OR file.path=/^.*\/usr\/share\/nginx\/html\/.*$/i OR file.path=/^.*\/srv\/http\/.*$/i OR file.path=/^.*\/tmp\/.*$/i OR file.path=/^.*\/dev\/shm\/.*$/i) AND (file.path=/^.*\.php$/i OR file.path=/^.*\.phtml$/i OR file.path=/^.*\.php5$/i OR file.path=/^.*\.sh$/i OR file.path=/^.*\.py$/i OR file.path=/^.*\.pl$/i OR file.path=/^.*\.so$/i OR file.path=/^.*\.elf$/i))

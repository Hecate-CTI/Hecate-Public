where((uri_path=/^.*\/api\/.*$/i OR uri_path=/^.*\/admin\/.*$/i OR uri_path=/^.*\/login.*$/i OR uri_path=/^.*\/auth.*$/i OR uri_path=/^.*\/root.*$/i OR uri_path=/^.*\/system.*$/i OR uri_path=/^.*\/config.*$/i) AND (http_status=200 OR http_status=201 OR http_status=202 OR http_status=204 OR http_status=301 OR http_status=302 OR http_status=303 OR http_status=307 OR http_status=308))

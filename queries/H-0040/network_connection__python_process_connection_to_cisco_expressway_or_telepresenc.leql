where((process.exe_path=/^.*\/python$/i OR process.exe_path=/^.*\/python3$/i OR process.exe_path=/^.*\/python2$/i OR process.exe_path=/^.*\/usr\/bin\/python$/i OR process.exe_path=/^.*\/usr\/bin\/python3$/i OR process.exe_path=/^.*\/usr\/local\/bin\/python$/i OR process.exe_path=/^.*\/usr\/local\/bin\/python3$/i) AND (destination_port=4372 OR destination_port=443 OR destination_port=8443))

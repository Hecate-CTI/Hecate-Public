where(parent_process.exe_path=/^.*\/node$/i AND parent_process.cmd_line=/^.*node-red.*$/i AND (process.exe_path=/^.*\/bin\/sh$/i OR process.exe_path=/^.*\/bin\/dash$/i OR process.exe_path=/^.*\/bin\/bash$/i OR process.exe_path=/^.*\/usr\/bin\/sh$/i OR process.exe_path=/^.*\/usr\/bin\/bash$/i) AND process.cmd_line=/^.* -c .*$/i)

EventType = "Process Creation" AND (EndpointOS = "linux" AND (SrcProcImagePath endswithCIS "/node" AND SrcProcCmdLine containsCIS "node-red" AND (TgtProcImagePath endswithCIS "/bin/sh" OR TgtProcImagePath endswithCIS "/bin/dash" OR TgtProcImagePath endswithCIS "/bin/bash" OR TgtProcImagePath endswithCIS "/usr/bin/sh" OR TgtProcImagePath endswithCIS "/usr/bin/bash") AND TgtProcCmdLine containsCIS " -c "))

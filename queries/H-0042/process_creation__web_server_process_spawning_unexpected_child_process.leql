where((parent_process.exe_path=/^.*\/php-fpm.*$/i OR parent_process.exe_path=/^.*\/apache2.*$/i OR parent_process.exe_path=/^.*\/nginx.*$/i OR parent_process.exe_path=/^.*\/httpd.*$/i) AND (process.exe_path=/^.*\/sh$/i OR process.exe_path=/^.*\/bash$/i OR process.exe_path=/^.*\/dash$/i OR process.exe_path=/^.*\/zsh$/i OR process.exe_path=/^.*\/python$/i OR process.exe_path=/^.*\/python3$/i OR process.exe_path=/^.*\/perl$/i OR process.exe_path=/^.*\/ruby$/i OR process.exe_path=/^.*\/curl$/i OR process.exe_path=/^.*\/wget$/i OR process.exe_path=/^.*\/nc$/i OR process.exe_path=/^.*\/ncat$/i OR process.exe_path=/^.*\/netcat$/i OR process.exe_path=/^.*\/socat$/i))
